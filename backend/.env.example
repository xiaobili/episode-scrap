# 数据库
DATABASE_URL=sqlite:///./episodescrap.db
SECRET_KEY=dev-secret-change-me
# Fernet key（留空则由 SECRET_KEY 派生）
ENCRYPTION_KEY=

# 媒体源
TMDB_API_KEY=

# 本地目录白名单（分号分隔，必须包含测试/媒体目录）
ALLOWED_PATHS=/data/media

# 并发与超时
SCRAPE_CONCURRENCY=3
OPENLIST_CONCURRENCY=3
OPENLIST_TIMEOUT=30
OPENLIST_RETRY=3

# 命名模板
RENAME_TEMPLATE={title} - S{season:02d}E{episode:02d} - {episode_title}
